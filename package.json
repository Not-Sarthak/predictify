{
  "name": "telegram-bot",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "bun run --watch src/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "set:wh": "bun run scripts/set-telegram-webhook.ts",
    "test:sqs": "bun run scripts/test-sqs.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.2.19",
    "@types/dotenv": "^8.2.3",
    "@types/react": "^19.1.8",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "3.6.1",
    "supabase": "^2.30.4",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.35.1"
  },
  "dependencies": {
    "@polymarket/clob-client": "^4.18.0",
    "@resvg/resvg-js": "^2.6.2",
    "@solana/web3.js": "^1.98.2",
    "@supabase/supabase-js": "^2.50.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.10.0",
    "bs58": "^6.0.0",
    "cron": "^4.3.2",
    "dotenv": "^16.5.0",
    "ethers": "^6.14.4",
    "luxon": "^3.7.1",
    "react": "^19.1.0",
    "redis": "^5.5.6",
    "satori": "^0.16.1",
    "telegraf": "^4.16.3",
    "zod": "^3.25.67"
  },
  "lint-staged": {
    "**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
