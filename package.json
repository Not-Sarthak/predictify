{
  "name": "telegram-bot",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:watch": "bun run --watch src/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:typegen": "bun run scripts/supabase-typegen.ts",
    "prepare": "husky",
    "lfg": "bun run src/utils/debridge/functions/get-token-list.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/bun": "latest",
    "@types/ws": "^8.5.10",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "3.6.1",
    "supabase": "^2.26.9",
    "typescript-eslint": "^8.35.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@polymarket/clob-client": "^4.18.0",
    "@polymarket/sdk": "^6.0.0",
    "@solana/web3.js": "^1.98.2",
    "@supabase/supabase-js": "^2.50.0",
    "@types/dotenv": "^8.2.3",
    "dotenv": "^16.5.0",
    "env-var": "^7.5.0",
    "eslint-config-prettier": "^10.1.5",
    "ethers": "^6.14.4",
    "fastify": "^5.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "redis": "^5.5.6",
    "telegraf": "^4.16.3",
    "websocket-client": "^1.0.0",
    "ws": "^8.18.2",
    "zod": "^3.25.67"
  },
  "lint-staged": {
    "**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}