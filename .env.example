# REDIS CONNECTION URL
REDIS_URL="PUT YOUR REDIS URL HERE"

# TELEGRAM BOT TOKEN (from BotFather)
TG_BOT_TOKEN="PUT YOUR TELGRAM BOT TOKEN HERE"

# SECRET TOKEN FOR WEBHOOKS
SECRET_TOKEN="PUT YOUR SECRET TOKEN HERE"

# KEY FOR ENCRYPTING WALLET KEYS AND CLOB API CREDENTIALS (64 HEX CHARS: openssl rand -hex 32)
PRIVATE_KEY_ENCRYPTION_KEY="PUT YOUR ENCRYPTION KEY HERE"

# WEBHOOK DOMAIN (SERVER DEPLOYMENT URL)
WEBHOOK_DOMAIN="PUT YOUR DOMAIN (YOUR DEPLOYED URL) HERE"

# WRAPPED USDC CONTRACT ADDRESS (Polygon Mainnet)
USDC_CONTRACT_ADDRESS="PUT YOUR USDC CONTRACT ADDRESS HERE"

# RPC URL FOR MAINNET
MAINNET_RPC_URL="PUT YOUR MAINNET RPC URL HERE"

# Supabase
PROJECT_ID="PUT YOUR PROJECT ID HERE"
SUPABASE_ACCESS_TOKEN="PUT YOUR SUPABASE ACCESS_TOKEN HERE"
SUPABASE_URL="PUT YOUR SUPABASE URL HERE"
SUPABASE_SERVICE_ROLE_KEY="PUT YOUR SUPABASE PUBLIC KEY HERE"

# PRIVATE KEY
PRIVATE_KEY="PUT YOUR PRIVATE KEY HERE"

# POLYMARKET CLOB API URL HERE
CLOB_API_URL="PUT CLOB API URL HERE"

# DEBRIDGE
DEBRIDGE_API_URL="PUT YOUR DEBRIDGE API URL HERE"
DEBRIDGE_API_KEY="PUT YOUR DEBRIDGE API KEY HERE"

TREASURY_ADDRESS="PUT YOUR TREASURY (WALLET) ADDRESS HERE"

# Optional
NODE_ENV="development or production"

DB_RETRY_COUNT=3
DB_TIMEOUT_MS=30000

# AWS SQS Configuration (Optional)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
SQS_QUEUE_URL="https://sqs.your-region.amazonaws.com/your-account-id/your-queue-name"